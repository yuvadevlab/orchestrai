# ==============================================================================
# OrchestrAI — Shared Infrastructure & Secrets (Template)
# ==============================================================================
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env — only .env.example is safe to commit.
#
# Strategy:
#   - Root .env       → shared infra (Local Store / DB, Redis, JWT, all LLM API keys)
#   - apps/*/.env     → app-specific only (PORT, HOST, CORS, feature flags)
#
# Zero-Docker Local Operation:
#   OrchestrAI automatically uses embedded local JSON storage (.data/orchestrai-local-store.json)
#   and in-memory event buses when DATABASE_URL or REDIS_URL are omitted.
# ==============================================================================

# ─── Storage (PostgreSQL 16 Native) ───────────────────────────────────────────
DATABASE_URL="postgresql://yuvarajpattabi:Yuva1213@localhost:5432/orchestrai_dev?schema=public"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yuvarajpattabi
POSTGRES_PASSWORD=Yuva1213
POSTGRES_DB=orchestrai_dev

# ─── Realtime / Broker (Optional: Redis for Multi-Node, In-Memory for Local) ──
# REDIS_URL="redis://localhost:6379"

# ─── Shared Security ─────────────────────────────────────────────────────────
# JWT_SECRET must be identical across all services (tokens cross service boundaries).
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
GATEWAY_API_KEY=<generate-or-configure-api-key>

# ─── HTTP Header Key Declarations ───────────────────────────────────────────
TENANT_HEADER_NAME="x-tenant-id"
API_KEY_HEADER_NAME="x-api-key"
AUTH_HEADER_NAME="authorization"
REQUEST_ID_HEADER_NAME="x-request-id"
SIGNATURE_HEADER_NAME="x-signature"
TIMESTAMP_HEADER_NAME="x-timestamp"
CLIENT_ID_HEADER_NAME="x-client-id"

# ─── LLM Configuration & Defaults ───────────────────────────────────────────
# Application-wide default provider and model (used as fallback if not specified per agent/tenant)
DEFAULT_MODEL_PROVIDER="ollama"
DEFAULT_MODEL_NAME="gemma4:31b-cloud"
DEFAULT_AGENT_TEMPERATURE=0.7
DEFAULT_MAX_AGENT_STEPS=20
DEFAULT_MAX_OUTPUT_TOKENS=2048
DEFAULT_CONTEXT_WINDOW=8192

# Ollama (local inference, no key needed)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="gemma4:31b-cloud"

# Groq (free fast cloud inference — OpenAI compatible)
GROQ_API_KEY=
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"

# OpenRouter (multi-model router — OpenAI compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api"
OPENROUTER_MODEL=

# Google AI Studio (Gemini — OpenAI compatible)
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GOOGLE_AI_STUDIO_MODEL="gemini-3.8-flash"

# Optional direct provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
