# ==============================================================================
# OrchestrAI — Shared Infrastructure & Secrets (Template)
# ==============================================================================
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env — only .env.example is safe to commit.
#
# Strategy:
#   - Root .env       → shared infra (DB, Redis, JWT, all LLM API keys)
#   - apps/*/.env     → app-specific only (PORT, HOST, CORS, feature flags)
#
# ⚠️  DB runs on port 5433 (Docker) to avoid collision with FinAI on 5432.
# ==============================================================================

# ─── PostgreSQL 16 + pgvector (Docker container) ─────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@localhost:5433/orchestrai_dev"
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=orchestrai_dev

# ─── Redis 7 (Docker container) ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Shared Security ─────────────────────────────────────────────────────────
# JWT_SECRET must be identical across all services (tokens cross service boundaries).
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Shared across gateway, worker, and console. Add only the keys you use.

# Ollama (local inference, no key needed)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:7b"

# Groq (free fast cloud inference — OpenAI compatible)
GROQ_API_KEY=
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"

# OpenRouter (multi-model router — OpenAI compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api"
OPENROUTER_MODEL=

# Google AI Studio (Gemini — OpenAI compatible)
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GOOGLE_AI_STUDIO_MODEL="gemini-3.8-flash"

# Optional direct provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
