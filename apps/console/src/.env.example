# ==============================================================================
# OrchestrAI Environment Configuration Example
# ==============================================================================
# NOTE: Ports 3000 and 4000 are allocated to the FinAI application.
# OrchestrAI uses 3001 (Console UI), 4001 (API Gateway), and 4002 (Realtime Streaming).
# ==============================================================================

# ─── 1. Application & Server Configuration ────────────────────────────────────
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_APP_NAME="OrchestrAI"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── 2. Backend Services & Gateway ───────────────────────────────────────────
API_PORT=4001
API_URL="http://localhost:4001"
NEXT_PUBLIC_API_URL="http://localhost:4001"

REALTIME_PORT=4002
REALTIME_URL="http://localhost:4002"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4002"

WORKER_PORT=4003

# ─── 3. PostgreSQL Database & Checkpointing ──────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orchestrai"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrai

# ─── 4. Redis (BullMQ Queues & Redis Streams) ─────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── 5. Security & Tokens ─────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-here"

# ─── 6. Model Providers & LLM Adapters ────────────────────────────────────────
# Ollama local inference server (default port 11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:7b"

# Groq (Free fast cloud inference - OpenAI compatible)
GROQ_API_KEY=
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"

# OpenRouter (Multi-model provider - OpenAI compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api"
OPENROUTER_MODEL="inclusionai/ling-3.0-flash-fin:free"

# Google AI Studio (Gemini - OpenAI compatible)
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GOOGLE_AI_STUDIO_MODEL="gemini-3.8-flash"

# OpenAI & Anthropic (optional direct keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── 7. Security & Execution Bounds ───────────────────────────────────────────
MAX_EXECUTION_STEPS=50
MAX_TOOL_CALLS_PER_STEP=5
EXECUTION_TIMEOUT_MS=120000
ENABLE_OUTBOX_POLLER=true

# ─── 8. Logging & Telemetry ───────────────────────────────────────────────────
LOG_LEVEL=info
NEXT_PUBLIC_TELEMETRY_ENABLED=true
