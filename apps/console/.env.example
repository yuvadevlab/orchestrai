# ==============================================================================
# apps/console — App-Specific Overrides (Template)
# ==============================================================================

NODE_ENV=development
CONSOLE_PORT=3001
LOG_LEVEL=info

# ─── Next.js Public Config ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="OrchestrAI"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── Gateway & Realtime Service Connections ──────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4001"
NEXT_PUBLIC_GATEWAY_API_KEY=
NEXT_PUBLIC_REALTIME_URL="http://localhost:4002"
NEXT_PUBLIC_TELEMETRY_ENABLED=true

# ─── Client Session & Header Config ──────────────────────────────────────────
NEXT_PUBLIC_AUTH_COOKIE_NAME="orch_token"
NEXT_PUBLIC_TENANT_COOKIE_NAME="orch_tenant"
NEXT_PUBLIC_AUTH_STORAGE_KEY="orchestrai_auth_session"
NEXT_PUBLIC_BROADCAST_CHANNEL_NAME="orchestrai_auth_sync"
NEXT_PUBLIC_SESSION_MAX_AGE_SECONDS=604800

# ─── Application Logging (@yuva-devlab/logger) ───────────────────────────────
LOG_ENABLED=true
LOG_LEVEL=info
LOG_PERSIST=false
LOG_FILE=
