# ==============================================================================
# apps/console — App-Specific Overrides (Template)
# ==============================================================================

NODE_ENV=development
CONSOLE_PORT=3001
LOG_LEVEL=info

# ─── Next.js Public Config ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="OrchestrAI"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── Gateway & Realtime Service Connections ──────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4001"
NEXT_PUBLIC_GATEWAY_API_KEY="dev-key"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4002"
NEXT_PUBLIC_TELEMETRY_ENABLED=true
