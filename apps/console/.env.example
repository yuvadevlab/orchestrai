# ==============================================================================
# apps/console — App-Specific Overrides (Template)
# ==============================================================================
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env — only .env.example is safe to commit.
#
# Shared infra (DB, Redis, JWT, LLM keys) → root .env
# Only console-specific vars live here.
# ==============================================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── Next.js Public Config ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="OrchestrAI"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── Backend Service URLs ─────────────────────────────────────────────────────
API_PORT=4001
API_URL="http://localhost:4001"
NEXT_PUBLIC_API_URL="http://localhost:4001"

REALTIME_PORT=4002
REALTIME_URL="http://localhost:4002"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4002"

WORKER_PORT=4003

# ─── Execution Bounds ─────────────────────────────────────────────────────────
MAX_EXECUTION_STEPS=50
MAX_TOOL_CALLS_PER_STEP=5
EXECUTION_TIMEOUT_MS=120000
ENABLE_OUTBOX_POLLER=true

# ─── Telemetry ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TELEMETRY_ENABLED=true
