# ==============================================================================
# OrchestrAI Background Worker Daemon Environment Example
# ==============================================================================
# In local development, the worker daemon diagnostics/metrics listen on port 4003.
# (Ports 3000 and 4000 are allocated to FinAI; 3001 is Console, 4001 is Gateway).
# ==============================================================================

# ─── Worker Process & Network ─────────────────────────────────────────────────
NODE_ENV=development
WORKER_PORT=4003
WORKER_ID="worker-daemon-01"
LOG_LEVEL=info

# ─── Redis & BullMQ Queue Broker ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Concurrency Limits ───────────────────────────────────────────────────────
AGENT_CONCURRENCY=5
TOOL_CONCURRENCY=10
MAINTENANCE_CONCURRENCY=2

# ─── Graceful Shutdown ────────────────────────────────────────────────────────
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000

# ─── Model Providers (For agent task execution) ────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:7b"
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Database & State Persistence ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orchestrai"
