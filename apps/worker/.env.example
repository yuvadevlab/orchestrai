# ==============================================================================
# apps/worker — App-Specific Overrides (Template)
# ==============================================================================
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env — only .env.example is safe to commit.
#
# Shared infra (DB, Redis, JWT, LLM keys) → root .env
# Only worker-specific vars live here.
# ==============================================================================

NODE_ENV=development
WORKER_PORT=4003
WORKER_ID="worker-daemon-01"
LOG_LEVEL=info

# ─── Concurrency Limits ───────────────────────────────────────────────────────
AGENT_CONCURRENCY=5
TOOL_CONCURRENCY=10
MAINTENANCE_CONCURRENCY=2

# ─── Graceful Shutdown ────────────────────────────────────────────────────────
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
