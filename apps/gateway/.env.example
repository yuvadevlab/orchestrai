# ==============================================================================
# apps/gateway — App-Specific Overrides (Template)
# ==============================================================================

NODE_ENV=development
GATEWAY_PORT=4001
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=info

# ─── Authentication & Security ────────────────────────────────────────────────
GATEWAY_API_KEY=

# ─── Database Connection Pool Sizing ──────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ─── Token Lifecycles ────────────────────────────────────────────────────────
TOKEN_EXPIRATION_HOURS=168
RESET_TOKEN_EXPIRATION_MINUTES=60

# ─── Rate Limiting & CORS ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CORS_ORIGIN="http://localhost:3001"

# ─── HTTP Header Declarations ─────────────────────────────────────────────────
TENANT_HEADER_NAME="x-tenant-id"
API_KEY_HEADER_NAME="x-api-key"
AUTH_HEADER_NAME="authorization"
REQUEST_ID_HEADER_NAME="x-request-id"
SIGNATURE_HEADER_NAME="x-signature"
TIMESTAMP_HEADER_NAME="x-timestamp"
CLIENT_ID_HEADER_NAME="x-client-id"

# ─── Internal Service Connections ─────────────────────────────────────────────
REALTIME_URL="http://localhost:4002"
WORKER_METRICS_URL="http://localhost:4003"
