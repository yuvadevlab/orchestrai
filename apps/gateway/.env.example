# OrchestrAI Public API Gateway Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Security
GATEWAY_API_KEY=orchestrai-dev-key-change-me
JWT_SECRET=super-secret-jwt-signing-key-for-dev

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# CORS Configuration
CORS_ORIGIN=*
