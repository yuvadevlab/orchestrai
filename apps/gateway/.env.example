# ==============================================================================
# apps/gateway — App-Specific Overrides (Template)
# ==============================================================================

NODE_ENV=development
GATEWAY_PORT=4001
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=info

# ─── Authentication & Security ────────────────────────────────────────────────
GATEWAY_API_KEY=

# ─── Database Connection Pool Sizing ──────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ─── Token Lifecycles ────────────────────────────────────────────────────────
TOKEN_EXPIRATION_HOURS=168
RESET_TOKEN_EXPIRATION_MINUTES=60

# ─── Rate Limiting & CORS ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CORS_ORIGIN="http://localhost:3001"

# ─── HTTP Header Declarations ─────────────────────────────────────────────────
TENANT_HEADER_NAME="x-tenant-id"
API_KEY_HEADER_NAME="x-api-key"
AUTH_HEADER_NAME="authorization"
REQUEST_ID_HEADER_NAME="x-request-id"
SIGNATURE_HEADER_NAME="x-signature"
TIMESTAMP_HEADER_NAME="x-timestamp"
CLIENT_ID_HEADER_NAME="x-client-id"

# ─── Internal Service Connections ─────────────────────────────────────────────
REALTIME_URL="http://localhost:4002"
WORKER_METRICS_URL="http://localhost:4003"
ORCHESTRATOR_GRPC_HOST="localhost:50051"

# ─── Agent Execution Limits ───────────────────────────────────────────────────
# Maximum autonomous turns per execution. Overrides the per-agent DB maxSteps ceiling.
# Increase for long-running tasks, decrease for strict cost control.
AGENT_MAX_TURNS=20

# ─── Model Context Configuration ─────────────────────────────────────────────
# Fallback context window size (tokens) when the DB model record has no contextWindow set.
# Should match the smallest model you run. Most 7B+ Ollama models support at least 8192.
MODEL_DEFAULT_CONTEXT_WINDOW=8192

# Fraction of the context window (0.5–0.95) at which compaction is triggered.
# 0.75 = compact when 75% full, leaving 25% room for the next response + tool result.
CONTEXT_COMPACTION_THRESHOLD=0.75

# ─── Billing & Budget ────────────────────────────────────────────────────────
# Default monthly spend cap in USD per tenant (0 = unlimited).
# Tenant-specific overrides are stored in the DB tenant record.
DEFAULT_MONTHLY_SPEND_CAP_USD=0
