# ==============================================================================
# apps/gateway — App-Specific Overrides (Template)
# ==============================================================================
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env — only .env.example is safe to commit.
#
# Shared infra (DB, Redis, JWT, LLM keys) → root .env
# Only gateway-specific vars live here.
# ==============================================================================

NODE_ENV=development
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Authentication ───────────────────────────────────────────────────────────
GATEWAY_API_KEY=orchestrai-dev-key-change-me-in-prod

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3001"

# ─── Internal Service URLs ────────────────────────────────────────────────────
REALTIME_URL="http://localhost:4002"
WORKER_METRICS_URL="http://localhost:4003"

# ─── Execution Bounds ─────────────────────────────────────────────────────────
MAX_EXECUTION_STEPS=50
MAX_TOOL_CALLS_PER_STEP=5
EXECUTION_TIMEOUT_MS=120000
ENABLE_OUTBOX_POLLER=true
