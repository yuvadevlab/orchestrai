# Environment variables for @orchestrai/realtime streaming broker

# Server Configuration
# OrchestrAI port allocation policy: 3001 (Console), 4001 (Gateway), 4002 (Realtime Broker), 4003 (Worker diagnostics)
PORT=4002
HOST=0.0.0.0
NODE_ENV=development

# Redis Event Bus & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Security & CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"
JWT_SECRET="orchestrai-dev-jwt-secret-key-change-in-production"

# Realtime Limits & Telemetry
HEARTBEAT_INTERVAL_MS=30000
CLIENT_TIMEOUT_MS=60000
MAX_CONNECTIONS=10000
MAX_PAYLOAD_BYTES=65536
RATE_LIMIT_PER_MIN=120
