# ==============================================================================
# apps/realtime — App-Specific Overrides (Template)
# ==============================================================================
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env — only .env.example is safe to commit.
#
# Shared infra (DB, Redis, JWT, LLM keys) → root .env
# Only realtime-specific vars live here.
# ==============================================================================

NODE_ENV=development
PORT=4002
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Security & CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3001,http://localhost:4001"

# ─── Realtime Limits & Telemetry ──────────────────────────────────────────────
HEARTBEAT_INTERVAL_MS=30000
CLIENT_TIMEOUT_MS=60000
MAX_CONNECTIONS=10000
MAX_PAYLOAD_BYTES=65536
RATE_LIMIT_PER_MIN=120
