{
  "name": "@orchestrai/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tool execution and safety perimeter layer for OrchestrAI — registry, permission gates, sandboxed runners, and built-in tools",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestrai/core": "workspace:*",
    "@orchestrai/shared-types": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.7"
  }
}
