{
  "name": "@orchestrai/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain contracts, Zod schemas, and core interfaces for OrchestrAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestrai/shared-types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
