    "@orchestrai/core": "workspace:*",
    "@orchestrai/shared-types": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
