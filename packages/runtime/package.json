{
  "name": "@orchestrai/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Directed state-graph DAG execution runtime and state checkpointing engine for OrchestrAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestrai/agent": "workspace:*",
    "@orchestrai/core": "workspace:*",
    "@orchestrai/models": "workspace:*",
    "@orchestrai/shared-types": "workspace:*",
    "@orchestrai/tools": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.7"
  }
}
