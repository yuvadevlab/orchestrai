{
  "name": "@orchestrai/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distributed tracing, OpenTelemetry integration, Prometheus metrics, and correlation context for OrchestrAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestrai/shared-types": "workspace:*",
    "@yuva-devlab/logger": "1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
