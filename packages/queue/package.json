{
  "name": "@orchestrai/queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ job producers, priority scheduling, and backpressure control for OrchestrAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestrai/core": "workspace:*",
    "@orchestrai/shared-types": "workspace:*",
    "@yuva-devlab/logger": "1.1.0",
    "bullmq": "^6.3.6",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
